<% layout("/layouts/boilerplate") -%>

<form method="POST" action="/listings/<%= individual_data._id %>?_method=PUT"
    novalidate class="needs-validation">
<div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input
        type="text"
        name="individual_data[title]"
        value="<%= individual_data.title %>"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please enter a title for your listing.
    </div>
</div>
<div class="mb-3">
    <label for="description" class="form-label">Description</label>
    <textarea
        class="form-control"
        name="individual_data[description]"
        required
    ><%= individual_data.description %></textarea>
    <div class="invalid-feedback">
        Tell us a little about your listing.
    </div>
</div>
<div class="mt-3">
    <label for="image" class="form-label">Image</label>
    <input
        type="text"
        name="individual_data[image][url]"
        value="<%= individual_data.image.url %>"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please add an image URL for your listing.
    </div>
</div>
<div class="row mt-3">
    <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price</label>
        <input
            type="number"
            name="individual_data[price]"
            value="<%= individual_data.price %>"
            class="form-control"
            required
        >
        <div class="invalid-feedback">
            Please enter the price per night.
        </div>
    </div>
    <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input
            type="text"
            name="individual_data[country]"
            value="<%= individual_data.country %>"
            class="form-control"
            required
        >
        <div class="invalid-feedback">
            Please enter the country.
        </div>
    </div>
</div>
<div class="mb-3">
    <label for="location" class="form-label">Location</label>
    <input
        type="text"
        name="individual_data[location]"
        value="<%= individual_data.location %>"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please enter the location of your listing.
    </div>
</div>
<button class="btn btn-dark add-btn mt-4" type="submit">
    Edit Listing
</button>
</form>
