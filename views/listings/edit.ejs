<% layout("/layouts/boilerplate") -%>
    <div class="row mt-5">
        <div class="col-8 offset-2">

            <form method="POST" action="/listings/<%= individual_data._id %>?_method=PUT">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="individual_data[title]" value="<%= individual_data.title %>"
                        class="form-control">
                </div>
                <div class="mb3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control"
                        name="individual_data[description]"><%= individual_data.description %></textarea>
                </div>
                <div class="mt-3">
                    <label for="image" class="form-label">Image</label>
                    <input type="text" name="individual_data[image][url]" value="<%= individual_data.image.url %>"
                        class="form-control">
                </div>
                <div class="row mt-3">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="individual_data[price]" value="<%= individual_data.price %>"
                            class="form-control">
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="individual_data[country]" value="<%= individual_data.country %>"
                            class="form-control">
                    </div>
                </div>
                <div class="mb3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="individual_data[location]" value="<%= individual_data.location %>"
                        class="form-control">
                </div>
                <button class="btn btn-dark add-btn mt-4">Edit</button>
            </form>
        </div>
    </div>