<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">

    <h2>Listing Details</h2>
    <div class="card">
        <img src="<%= individual_data.image.url %>" class="card-img-top show-img" alt="Listed_image">
        <div class="card-body">
            <p class="card-text">
                <b><%= individual_data.title %></b> <br><br>
                <%= individual_data.description %> <br>
                &#8377 <%= individual_data.price.toLocaleString("en-IN")%> <br>
                <%= individual_data.location %> <br>
                <%= individual_data.country %> <br>
            </p>
        </div>
    </div>
    <a href="/listings/<%= individual_data._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
    <br><br>
    <form action="/listings/<%= individual_data._id %>?_method=DELETE" method="post">
        <button class="btn btn-dark">Delete</button>
    </form>
    <br>
    <br>
    </div>
</div>
