<% layout("/layouts/boilerplate") -%>

<div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">
        <h2 class="mb-4"><%= individual_data.title %></h2>
        <!-- Listing Card -->
        <div class="card shadow-sm listing-card mb-3">
            <img 
                src="<%= individual_data.image.url %>" 
                class="card-img-top show-img" 
                alt="Listed_image"
            >
            <div class="card-body">
                <p class="card-text text-muted mb-0">
                    <%= individual_data.description %>
                </p>
                <div class="mt-3">
                    <p class="mb-1">
                        <strong>₹ <%= individual_data.price.toLocaleString("en-IN") %></strong>
                    </p>
                    <p class="mb-1">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= individual_data.location %>
                    </p>
                    <p class="mb-0">
                        <%= individual_data.country %>
                    </p>
                </div>
            </div>
        </div>
        <!-- Edit & Delete -->
        <div class="d-flex gap-2 mb-4">
            <a 
                href="/listings/<%= individual_data._id %>/edit" 
                class="btn btn-dark"
            >
                Edit
            </a>
            <form 
                action="/listings/<%= individual_data._id %>?_method=DELETE" 
                method="post"
            >
                <button class="btn btn-outline-danger">
                    Delete
                </button>
            </form>
        </div>
        <hr>
        <!-- Review Section -->
        <div class="review-section mt-4">
            <h4 class="mb-3">Leave a review</h4>
            <form 
                action="/listings/<%= individual_data._id %>/reviews" 
                method="post" 
                novalidate 
                class="needs-validation review-form"
            >

                <div class="mb-3">
        <label class="form-label">Rating</label>
        <div class="star-rating">
            <input type="radio" id="star5" name="review[rating]" value="5" required>
            <label for="star5">★</label>
            <input type="radio" id="star4" name="review[rating]" value="4">
            <label for="star4">★</label>
            <input type="radio" id="star3" name="review[rating]" value="3">
            <label for="star3">★</label>
            <input type="radio" id="star2" name="review[rating]" value="2">
            <label for="star2">★</label>
            <input type="radio" id="star1" name="review[rating]" value="1">
            <label for="star1">★</label>
        </div>
</div>
                <div class="mb-3">
                    <label for="comment" class="form-label">
                        Comment
                    </label>
                    <textarea 
                        name="review[comment]" 
                        id="comment" 
                        rows="5" 
                        class="form-control"
                        placeholder="Write your review..."
                        required
                    ></textarea>
                </div>
                <button class="btn btn-outline-dark px-4">
                    Submit Review
                </button>
            </form>
            <!-- Reviews -->
            <h4 class="mt-5 mb-3">All Reviews</h4>
            <div class="row g-3">
                <% for(let review of individual_data.reviews) { %>
                    <div class="col-md-6">
                        <div class="card review-card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="card-title mb-0">
                                        Saieshwar
                                    </h5>
                                    <span class="badge bg-dark">
                                        <%= review.rating %> ★
                                    </span>
                                </div>
                                <p class="card-text text-muted">
                                    <%= review.comment %>
                                </p>
                            </div>
                            <div class="card-footer bg-white border-0">
                                <form 
                                    method="post" 
                                    action="/listings/<%= individual_data._id %>/reviews/<%= review.id %>?_method=DELETE"
                                >
                                    <button class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<script src="/javascript/script.js"></script>
