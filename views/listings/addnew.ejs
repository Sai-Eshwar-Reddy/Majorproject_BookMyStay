<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-8 offset-2" >
            <br><br>
    <h3>Create a new listing</h3>
    <form action="/listings" method="post">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="new_listing[title]" placeholder="Enter title" class="form-control">
        </div>
        <div class="mb-3"> 
            <label for="description" class="form-label">Description</label>
            <textarea name="new_listing[description]" class="form-control" ></textarea>
        </div>
        <div class="mb-4">
            <label for="image" class="form-label">Image</label>
            <input name="new_listing[image]" placeholder="Enter image URL/LINK" class="form-control">
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input type="number" name="new_listing[price]" placeholder="Enter price" class="form-control">
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">country</label>
                <input type="text" name="new_listing[country]" placeholder="Enter country" class="form-control">
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="new_listing[location]" placeholder="Enter location" class="form-control">
        </div>
        <br>
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>
    </form>
    </div>
    </div>

