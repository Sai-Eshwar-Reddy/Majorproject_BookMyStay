<% layout("/layouts/boilerplate") -%>
<body>
    <!--Success flash-->
    <% if (success && success.length > 0) { %>
        <div id="success-alert" class="success-alert">
            <span class="success-icon">✓</span>
            <span><%= success[0] %></span>
        </div>
    <% } %>
    <script>
        setTimeout(() => {
            const alert = document.getElementById("success-alert");
            if (alert) {
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
            setTimeout(() => {
                alert.remove();
            }, 300);
        }}, 3000);
    </script>

    <!--Delete Flash-->
    <% if (deleted && deleted.length > 0) { %>
        <div id="delete-alert" class="delete-alert">
        <span class="delete-icon">
            <i class="bi bi-trash3"></i>
        </span>
        <span><%= deleted[0] %></span>
        </div>
    <% } %>

    <script>
        setTimeout(() => {
            const alert = document.getElementById("delete-alert");
            if (alert) {
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
            setTimeout(() => {
                alert.remove();
            }, 300);
        }}, 3000);
    </script>

    <br><br>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
        <% for(let listing of all_data) { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="Listed_image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %> <br></b>
                            &#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %>/Night
                        </p>
                    </div>
        </div>
        </a>
    <% } %>
    </div>
</body>
